#!/bin/sh
# Owner CLI; do not expose this host runtime command through an agent tool.
set -eu
if [ "${1:-}" != agent ] || [ "${2:-}" != import ] || [ "${3:-}" != hermes ]; then
  printf '%s\n' 'usage: wizard agent import hermes scan|approve|apply|undo|route-default|lifecycle|recovery-home ...' >&2
  exit 2
fi
shift 3
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ "${1:-}" = recovery-home ]; then
  shift
  exec uv run --no-project --with 'PyYAML>=6.0.2,<7' --with 'python-dotenv>=1,<2' python "$here/recovery_home.py" "$@"
fi
exec uv run --no-project --with 'PyYAML>=6.0.2,<7' python "$here/hermes_import.py" "$@"
