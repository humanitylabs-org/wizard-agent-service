# EnvironmentFile for wizard-agent-runtime.service. Copy to ~/.config/wizard-agent-runtime/runtime.env
# with mode 0600. Values are per box; never commit a filled-in copy. systemd does not expand %h here,
# so write absolute paths.

# wizard-app-manager checkout the runtipi driver uses (--wam). Must be an origin/main commit.
WIZARD_RUNTIME_WAM=

# Optional extra flags for agent_runtime.py, separated by spaces, for example
#   --tinfoil-key-file /absolute/path/to/tinfoil-key.env --main-container <main Hermes container>
# Leave empty when not needed.
WIZARD_RUNTIME_EXTRA_ARGS=

# Secret values a runtime release reads from its environment go below this line, one KEY=value each.
